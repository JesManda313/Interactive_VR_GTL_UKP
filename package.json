    "android:run": "npm run build && npx cap sync android && npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/preferences": "^6.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "vite": "^5.4.21"
  }
}
