{
  "name": "gtl-aframe-capacitor-vr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync android",
